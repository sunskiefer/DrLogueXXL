{
  "name": "DrLogueXXL",
  "vendor": "L'Cronx",
  "uid": "AnDl",
  "version": 1000,
  "so": "drloguexxl.so",
  "params": "params.json",
  "build": {
    "root": ".",
    "sources": [
      "src/vst_glue.cc",
      "src/dlx_engine.cc",
      "src/parts/bd.cc",
      "src/parts/sd.cc",
      "src/parts/tom.cc",
      "src/parts/pcm.cc",
      "src/rom/sample_rom.cc",
      "src/rom/synth_util.cc",
      "src/rom/synth_gen.cc",
      "src/rom/synth_banks.cc",
      "src/rom/wav.cc",
      "src/fx/delay.cc",
      "src/fx/reverb.cc",
      "src/fx/master.cc"
    ],
    "cflags": [
      "-Isrc",
      "-Ithird_party/logue-sdk/platform/drumlogue/common",
      "-Ithird_party/mutable",
      "-Ithird_party/community/cldmnky/clouds-revfx"
    ],
    "libs": [
      "-lm",
      "-ldl",
      "-lpthread"
    ]
  },
  "title_font": "art/fonts/TitilliumWeb-SemiBold.ttf",
  "defines": {
    "HAS_LFO_BPM": 1,
    "MODULE_SUBDIR": "\"Samples\""
  },
  "layout": "layout.conf"
